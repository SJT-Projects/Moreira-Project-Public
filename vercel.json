{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "moreira": {
      "root": ".",
      "entrypoint": "index.py",
      "framework": "fastapi",
      "maxDuration": 60,
      "includeFiles": [
        "backend/**",
        "public/**",
        "requirements.txt"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "moreira"
      }
    }
  ]
}
